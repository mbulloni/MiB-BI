{
  "name": "mib-bi",
  "version": "1.10.1",
  "description": "MiB-BI - clone educativo di Power BI Desktop per Linux",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV=1 electron . --no-sandbox\"",
    "build": "vite build",
    "start": "vite build && electron . --no-sandbox",
    "typecheck": "tsc --noEmit",
    "dist": "vite build && electron-builder --linux AppImage",
    "setup:pbix": "python3 -m venv .venv-pbix && .venv-pbix/bin/pip install pbixray pyarrow",
    "dist:deb": "vite build && electron-builder --linux deb"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@clickhouse/client": "^1.24.1",
    "@databricks/sql": "^2.3.0",
    "@duckdb/node-api": "^1.5.6-r.1",
    "@google-cloud/bigquery": "^9.4.0",
    "echarts": "^6.1.0",
    "jquery": "^3.7.1",
    "jszip": "^3.10.2",
    "lodash": "^4.18.1",
    "mdb-reader": "^3.2.0",
    "mongodb": "^7.7.0",
    "mssql": "^12.7.10",
    "odbc": "^2.6.0",
    "oracledb": "^26.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-rnd": "^10.5.3",
    "snowflake-sdk": "^3.4.0",
    "topojson-client": "^3.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "i18n-iso-countries": "^7.14.0",
    "mapshaper": "^0.7.90",
    "typescript": "^7.0.2",
    "us-atlas": "^3.0.1",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1",
    "world-atlas": "^2.0.2"
  },
  "build": {
    "appId": "it.michele.mib-bi",
    "productName": "MiB-BI",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@duckdb/**",
      "electron/pbix/**"
    ],
    "linux": {
      "category": "Office",
      "target": [
        "AppImage"
      ],
      "icon": "build/icons",
      "executableName": "mib-bi",
      "synopsis": "Clone educativo di Power BI Desktop per Linux",
      "description": "Report e analisi dati con Power Query, DAX, modello a stella; apre file Power BI (.pbix, .pbit, .pbip).",
      "mimeTypes": [
        "application/x-mib-bi"
      ],
      "desktop": {
        "entry": {
          "StartupWMClass": "mib-bi"
        }
      },
      "syncDesktopName": true
    },
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "fileAssociations": [
      {
        "ext": "mibx",
        "name": "Report MiB-BI",
        "mimeType": "application/x-mib-bi"
      },
      {
        "ext": "pbix",
        "name": "Report Power BI",
        "mimeType": "application/vnd.ms-powerbi.report"
      },
      {
        "ext": "pbit",
        "name": "Modello Power BI",
        "mimeType": "application/vnd.ms-powerbi.template"
      },
      {
        "ext": "pbip",
        "name": "Progetto Power BI",
        "mimeType": "application/vnd.ms-powerbi.project"
      }
    ],
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libasound2t64 | libasound2",
        "python3"
      ]
    }
  },
  "author": {
    "name": "Michele",
    "email": "m.bulloni@gmail.com"
  },
  "desktopName": "mib-bi.desktop",
  "homepage": "https://github.com/mbulloni/MiB-BI",
  "repository": {
    "type": "git",
    "url": "https://github.com/mbulloni/MiB-BI.git"
  },
  "license": "MIT",
  "allowScripts": {
    "odbc@2.6.0": true
  }
}
